APP_NAME="Private Pickleball Court Reservation System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=Asia/Manila

FACILITY_OPENING_HOUR=9
FACILITY_CLOSING_HOUR=21

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Concurrent request workers. The payment simulator posts a webhook to this
# application's own endpoint while its own request is still open, so the
# single-threaded dev server would deadlock without this.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=court_reservation
DB_USERNAME=court_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=failover
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="reservations@sanjosecourts.test"
MAIL_FROM_NAME="${APP_NAME}"

# Recommended live/demo mailer: Gmail SMTP delivers to any valid recipient
# address. Use a Google App Password, never the normal account password.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-demo-email@gmail.com
# MAIL_PASSWORD=your-16-character-app-password
# MAIL_FROM_ADDRESS=your-demo-email@gmail.com
# MAIL_FROM_NAME="San Jose Pickleball"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Used by AdminUserSeeder to create the first administrator account.
# Never commit a real password; generate one with: openssl rand -base64 24
ADMIN_EMAIL=admin@court.local
ADMIN_PASSWORD=

# Payment integration. Use PayMongo Test Mode during development.
# Get the secret test key from PayMongo Dashboard → Developers → API Keys.
PAYMENT_GATEWAY=paymongo
PAYMONGO_SECRET_KEY=
PAYMONGO_BASE_URL=https://api.paymongo.com
PAYMONGO_WEBHOOK_PATH=webhooks/paymongo
# Set to a public HTTPS tunnel locally or to the deployed application URL.
PAYMONGO_WEBHOOK_URL=
# Set after creating the webhook in PayMongo Dashboard → Developers → Webhooks.
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_WEBHOOK_RATE_LIMIT=60

# --- Mailtrap (optional local development only) ---
# SMTP username and password come from the Mailtrap inbox settings.
# MAIL_MAILER=failover falls back to the log driver if Mailtrap is unreachable.
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
